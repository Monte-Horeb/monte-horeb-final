# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─── Supabase (required) ────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-side only. Bypasses row level security - never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Site (required) ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://sdcmontehoreb.com

# ─── Admin (required) ───────────────────────────────────────
# Only this address can reach /admin. It must match an existing user in
# Supabase Auth, AND the email listed in public.is_admin() in
# supabase/schema.sql - the middleware and the database policies are
# checked independently.
NEXT_PUBLIC_ADMIN_EMAIL=robinsonramos96@gmail.com

# ─── Email notifications (optional) ─────────────────────────
# Without RESEND_API_KEY, contact form submissions are still saved to the
# database - you just will not get an email about them.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@sdcmontehoreb.com
CHURCH_CONTACT_EMAIL=sdcmontehoreb@gmail.com

# ─── Book store payments: Stripe (optional) ─────────────────
# Without these the store still browses fine; only Checkout is disabled.
# Test keys start sk_test_ / pk_test_. Use TEST keys until you have placed a
# successful test order, then swap to live keys.
STRIPE_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# From Stripe Dashboard → Developers → Webhooks → your endpoint → signing
# secret. Locally, `stripe listen` prints one. The webhook REJECTS every
# request if this is wrong, so orders would never be marked paid.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Flat sales tax applied at checkout. 0.0975 = 9.75%. Set to 0 for none.
# Used by BOTH the cart display and the Stripe session, so they always agree.
NEXT_PUBLIC_SALES_TAX_RATE=0.0975

# ─── Giving (display only - no API involved) ────────────────
NEXT_PUBLIC_ZELLE_PHONE=+1-323-496-6815
NEXT_PUBLIC_ZELLE_EMAIL=sdcmontehoreb@gmail.com

# NOTE: the previous env.example listed NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
# No key is needed: the site embeds the free Google Maps iframe, so that
# variable has been removed.
